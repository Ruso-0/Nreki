{
    "extends": "./tsconfig.json",
    "compilerOptions": {
        "rootDir": ".",
        "noEmit": true,
        "noUnusedLocals": false,
        "noUnusedParameters": false
    },
    "include": [
        "src/**/*",
        "tests/**/*.ts"
    ],
    "exclude": [
        "node_modules",
        "dist",
        "wasm"
    ]
}
